.parcel-cache/
.eslintcache
.stylelintcache
.node_repl_history
*.tgz

# ────────────────────────────────────────────────────────────
# 🗄️ DATABASE (SQLite — auto-generated)
# ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
database/*.db
database/*.sqlite3
database/platform.db

# Keep schema & seed, ignore actual DB
!database/schema.sql
!database/seed.sql
!database/.gitkeep

# ────────────────────────────────────────────────────────────
# 📤 UPLOADS & OUTPUTS (User-generated content)
# ────────────────────────────────────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep

backend/outputs/*
!backend/outputs/.gitkeep

uploads/
outputs/
temp/
tmp/
*.tmp
*.log

# ────────────────────────────────────────────────────────────
