# ☁️ CLOUD / DEPLOYMENT
# ────────────────────────────────────────────────────────────
.vercel
.netlify
.firebase/
*.firebase
.aws/
.serverless/
.serverless.d/

# ────────────────────────────────────────────────────────────
# 🧪 TESTING
# ────────────────────────────────────────────────────────────
.pytest_cache/
.tox/
.nox/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.hypothesis/
.testmondata

# ────────────────────────────────────────────────────────────
# 📦 MISC
# ────────────────────────────────────────────────────────────
*.bak
*.backup
*.orig
*.rej
*.swp
*.swo
*.pid
*.seed
*.pid.lock
.cache/
temp/
