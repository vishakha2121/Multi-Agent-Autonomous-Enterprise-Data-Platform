# ────────────────────────────────────────────────────────────
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib

# Keep sample test data
!backend/tests/sample_data/*.csv

# ────────────────────────────────────────────────────────────
# 📝 LOGS
# ────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
